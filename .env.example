# Kult API gateway. Every call goes through the app's own server routes,
# so the gateway never sees a browser origin from this app.
KULT_GATEWAY_URL=https://aiarena-gateway.kult.games

# Base RPC used by the server for transaction timestamps.
# The public endpoint works for light reads; use a dedicated provider in production.
BASE_RPC_URL=https://mainnet.base.org

# Public URL of this app (used for share links and Open Graph images).
NEXT_PUBLIC_APP_URL=https://baseapp.kult.games
